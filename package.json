{
  "name": "cold-chain-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "NODE_ENV=test jest --detectOpenHandles --forceExit",
    "test:watch": "NODE_ENV=test jest --watch"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "element-plus": "^2.5.0",
    "express": "^4.18.0",
    "file-saver": "^2.0.5",
    "mongoose": "^8.0.0",
    "pinia": "^2.1.0",
    "serverless-http": "^3.2.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.0",
    "supertest": "^6.3.0",
    "vite": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "api/**/*.js",
      "!api/index.js"
    ]
  }
}
